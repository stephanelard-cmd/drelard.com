{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -m http.server 8080 --bind 127.0.0.1",
      "startServerReadyPattern": "Serving HTTP",
      "startServerReadyTimeout": 15000,
      "url": [
        "http://127.0.0.1:8080/",
        "http://127.0.0.1:8080/prolapsus-genital/",
        "http://127.0.0.1:8080/rendez-vous/",
        "http://127.0.0.1:8080/plan-du-site/",
        "http://127.0.0.1:8080/accessibilite/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": [
          "accessibility",
          "seo",
          "best-practices"
        ],
        "chromeFlags": "--headless --no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.85
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-reports"
    }
  }
}
