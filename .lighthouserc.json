{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/",
        "http://localhost/prolapsus-genital/",
        "http://localhost/rendez-vous/",
        "http://localhost/plan-du-site/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": [
          "accessibility",
          "seo",
          "best-practices"
        ],
        "chromeFlags": "--headless --no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.85
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-reports"
    }
  }
}
