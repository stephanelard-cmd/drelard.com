   "data": {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://drelard.com/prolapsus-genital/#faq",
    "mainEntity": [
     {
      "@type": "Question",
      "name": "Faut-il toujours opérer une descente d’organes ?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Non. L’absence de gêne importante peut conduire à une simple surveillance. Les mesures quotidiennes, la rééducation ou un pessaire sont souvent proposés avant ou à la place d’une intervention."
      }
     },
     {
      "@type": "Question",
      "name": "La chirurgie robotique est-elle toujours préférable ?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Non. L’assistance robotique est une modalité technique parmi d’autres. La voie vaginale ou la cœlioscopie conventionnelle peuvent être plus adaptées selon le type de prolapsus, les antécédents et les objectifs."
      }
     },
     {
      "@type": "Question",
      "name": "Un prolapsus peut-il récidiver ?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Oui. Une récidive anatomique est possible plusieurs mois ou années après le traitement, sans qu’elle entraîne nécessairement de nouveaux symptômes. Le risque varie selon chaque patiente."
      }
     }
    ]
   }
